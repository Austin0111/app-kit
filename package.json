{
  "name": "app-kit",
  "version": "0.2.8",
  "description": "新規デスクトップアプリの雛形（electron-vite + React + TypeScript + better-sqlite3 + Drizzle）",
  "main": "./out/main/index.js",
  "author": "Austin",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run check:names",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:screenshots": "playwright test tests/screenshot.spec.ts",
    "test:packaged": "node scripts/test-packaged.mjs",
    "dist": "npm run build && electron-builder",
    "release:verify": "node scripts/release-verify.mjs",
    "verify": "npm run typecheck && npm run check:names && electron-vite build && playwright test",
    "check:names": "node scripts/check-names.mjs",
    "db:generate": "drizzle-kit generate",
    "rebuild": "electron-rebuild -w better-sqlite3"
  },
  "build": {
    "appId": "dev.austin.app-kit",
    "productName": "app-kit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "drizzle/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
